  "en-intro": {
    "text": "Welcome Little Readers! Let us learn and play!",
    "file": "audio/en/en-intro.mp3"
  },
  "en-alphabet": {
    "text": "Listen to the alphabet sounds and names.",
    "file": "audio/en/en-alphabet.mp3"
  },
  "en-s1": {
    "text": "Tap the small partner for each letter.",
    "file": "audio/en/en-s1.mp3"
  },
  "en-s2": {
    "text": "Some letters live in grass. Tap them.",
    "file": "audio/en/en-s2.mp3"
  },
  "en-s3": {
    "text": "Tap the first letter of each picture.",
    "file": "audio/en/en-s3.mp3"
  },
  "en-s4": {
    "text": "Draw a line from picture to word.",
    "file": "audio/en/en-s4.mp3"
  },
  "en-s5": {
    "text": "Tap words in order to make sentences.",
    "file": "audio/en/en-s5.mp3"
  },
  "en-s6": {
    "text": "How do they feel? Tap the word.",
    "file": "audio/en/en-s6.mp3"
  },
  "en-draw": {
    "text": "Draw your favourite animal on the canvas.",
    "file": "audio/en/en-draw.mp3"
  },
  "q-start": {
    "text": "Let us begin our fun worksheet now!",
    "file": "audio/en/q-start.mp3"
  },
  "ma-intro": {
    "text": "Welcome Number Buddies! Let us count together!",
    "file": "audio/en/ma-intro.mp3"
  },
  "ma-s1": {
    "text": "Count the objects and choose the number.",
    "file": "audio/en/ma-s1.mp3"
  },
  "ma-s2": {
    "text": "What comes next? Tap the missing number.",
    "file": "audio/en/ma-s2.mp3"
  },
  "ma-s3": {
    "text": "Match each number word to its digit.",
    "file": "audio/en/ma-s3.mp3"
  },
  "ma-s4": {
    "text": "Fill the blank numbers in the grid.",
    "file": "audio/en/ma-s4.mp3"
  },
  "ma-s5-shape": {
    "text": "Look at the shape. Tap its name.",
    "file": "audio/en/ma-s5-shape.mp3"
  },
  "ma-s5-small": {
    "text": "Colour the small flower with any colour.",
    "file": "audio/en/ma-s5-small.mp3"
  },
  "ma-s5-big": {
    "text": "Colour the big house with any colour.",
    "file": "audio/en/ma-s5-big.mp3"
  },
  "ma-draw": {
    "text": "Draw anything with a shape in it.",
    "file": "audio/en/ma-draw.mp3"
  },
  "ui-verify": {
    "text": "Check my answers and show results.",
    "file": "audio/en/ui-verify.mp3"
  },
  "ui-well-done": {
    "text": "Well done! You finished the worksheet!",
    "file": "audio/en/ui-well-done.mp3"
  },
  "tier-perfect": {
    "text": "Awesome job! You got every answer right!",
    "file": "audio/en/tier-perfect.mp3"
  },
  "tier-good": {
    "text": "Good job! You did really great work!",
    "file": "audio/en/tier-good.mp3"
  },
  "tier-average": {
    "text": "Nice effort! Keep practicing every day!",
    "file": "audio/en/tier-average.mp3"
  },
  "tier-needs": {
    "text": "Keep trying! You will do even better!",
    "file": "audio/en/tier-needs.mp3"
  }
